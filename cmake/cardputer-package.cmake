# Debian/APPLaunch layout adapted for RadioFieldKitZero, following CardputerZero Template.
option(RFK_ENABLE_DEB "Enable the ARM64 Debian packaging target" OFF)
set(RFK_DEB_MAINTAINER "" CACHE STRING "Approved package contact: Name <email>")
set(RFK_APP_ICON "" CACHE FILEPATH "Path to generated 256 x 256 PNG icon")
if(NOT RFK_ENABLE_DEB)
  return()
endif()
if(NOT RFK_DEB_MAINTAINER MATCHES "^[^<>]+ <[^<> ]+@[^<> ]+>$")
  message(FATAL_ERROR "Set the approved RFK_DEB_MAINTAINER contact before preparing a Debian package.")
endif()
if(NOT EXISTS "${RFK_APP_ICON}")
  message(FATAL_ERROR "Generate the launcher PNG and set RFK_APP_ICON.")
endif()

# LVGL is linked statically and registers its own default development install rules.
# Package only this application's runtime component, not the default ALL install.
set(_rfk_runtime "RadioFieldKitZeroRuntime")
install(TARGETS radiofieldkitzero RUNTIME DESTINATION bin COMPONENT "${_rfk_runtime}")
install(FILES packaging/radiofieldkitzero.desktop DESTINATION share/APPLaunch/applications COMPONENT "${_rfk_runtime}")
install(FILES "${RFK_APP_ICON}" DESTINATION share/APPLaunch/share/images RENAME radiofieldkitzero.png COMPONENT "${_rfk_runtime}")
install(FILES LICENSE README.md THIRD-PARTY-NOTICES.md DESTINATION share/doc/radiofieldkitzero COMPONENT "${_rfk_runtime}")
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/licenses")
  install(DIRECTORY licenses/ DESTINATION share/doc/radiofieldkitzero/licenses COMPONENT "${_rfk_runtime}")
endif()
set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};${CMAKE_PROJECT_NAME};${_rfk_runtime};/")
set(CPACK_GENERATOR "DEB")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_PACKAGE_NAME "radiofieldkitzero")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Pocket amateur radio field tools for the M5Stack Cardputer Zero")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_DEBIAN_PACKAGE_NAME "radiofieldkitzero")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "arm64")
set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${RFK_DEB_MAINTAINER}")
set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
set(CPACK_DEBIAN_PACKAGE_DEPENDS "libc6, libstdc++6, libgcc-s1, curl, ca-certificates")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
include(CPack)
